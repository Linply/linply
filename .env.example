# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/customer_service_agent

# Auth
# Public origin used to build the OAuth callback URL. No trailing path.
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Used by `pnpm auth:create-admin`; do not commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=系统管理员
# Optional: enables the login page's one-click admin demo entry.
# The account must already exist and have the admin role.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=replace-with-a-demo-password

# Optional Redis cache for active login sessions. PostgreSQL remains authoritative.
# Remove REDIS_URL to disable the cache. This TTL is an authorization snapshot
# window, not the 30-day absolute session lifetime; keep it short.
REDIS_URL=redis://localhost:6379
# BullMQ can share Redis initially. Use a dedicated Redis service at higher load.
QUEUE_REDIS_URL=redis://localhost:6379
SESSION_CACHE_TTL_MS=60000
SESSION_CACHE_CONNECT_TIMEOUT_MS=1000
SESSION_CACHE_COMMAND_TIMEOUT_MS=250
# Optional credentials for `pnpm db:seed`. A random password is printed when omitted.
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=

# Local MCP server identity. Required when running `pnpm mcp`.
# Use a numeric users.id from the database. MCP_ROLE defaults to "user"; set
# "admin" only for an existing admin user.
MCP_USER_ID=1
MCP_ROLE=user

# Optional Agent SDK knobs. Tracing stays redacted; handoffs are kept off until multi-agent routing is explicitly enabled.
# Before deployment, run database migrations so agent_runs and agent_run_steps exist.
AGENT_TRACING_ENABLED=false
AGENT_HANDOFFS_ENABLED=false
# 本地默认 inline；Railway Web 服务设为 worker，由独立 worker Service 领取 queued Run
AGENT_EXECUTION_MODE=inline
AGENT_WORKER_POLL_MS=500
AGENT_WORKER_LEASE_MS=60000
AGENT_WORKER_MAX_ATTEMPTS=3

# Knowledge document multipart uploads (Railway Bucket or another S3-compatible store)
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
AWS_S3_FORCE_PATH_STYLE=false
# Local MinIO example (start `docker compose up -d minio minio-init`):
# AWS_ENDPOINT_URL=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_S3_BUCKET_NAME=knowledge
# AWS_DEFAULT_REGION=us-east-1
# AWS_S3_FORCE_PATH_STYLE=true
KNOWLEDGE_UPLOAD_PART_SIZE_MB=16
KNOWLEDGE_UPLOAD_URL_TTL_SECONDS=3600
KNOWLEDGE_UPLOAD_SESSION_TTL_HOURS=24
KNOWLEDGE_PARSE_CONCURRENCY=1
KNOWLEDGE_EMBED_CONCURRENCY=2

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5.5
# Used only for the usage ratio shown in chat and Agent Run details.
OPENAI_CONTEXT_WINDOW_TOKENS=272000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: override embeddings when a company proxy uses a different route/model.
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_PATH=/v1/embeddings
# Embeddings provider: use "local" for a local OpenAI-compatible embedding server,
# "voyage" for Voyage AI, or "openai" to keep OpenAI embeddings.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_BASE_URL=http://localhost:8080
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_PATH=/v1/embeddings
# Optional runtime model for the built-in Transformers.js embedding endpoint.
LOCAL_EMBEDDING_RUNTIME_MODEL=Xenova/bge-small-zh-v1.5
# Optional, only when your local embedding server requires an auth token.
LOCAL_EMBEDDING_API_KEY=
VOYAGE_API_KEY=pa-your-voyage-api-key
VOYAGE_BASE_URL=https://api.voyageai.com
VOYAGE_EMBEDDING_MODEL=voyage-3-large
VOYAGE_EMBEDDING_PATH=/v1/embeddings
# Set to false when your proxy has not enabled embeddings yet; keyword RAG fallback stays active.
RAG_EMBEDDINGS_ENABLED=true

POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# OpenTelemetry traces (OTLP/HTTP). Configure the same exporter for Web and Worker.
# Setting either OTLP endpoint also enables telemetry; OTEL_ENABLED is an explicit switch.
OTEL_ENABLED=false
OTEL_SERVICE_NAMESPACE=customer-service-agent
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Example for a hosted collector: Authorization=Bearer%20your-token
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# App
# Runtime observability logs provider/model/latency/token metadata and redacts keys, cookies, passwords, and card-like values.
VITE_APP_TITLE=客服工单系统
VITE_APP_LOGO=https://example.com/logo.png
